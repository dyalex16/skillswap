
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password      String
  isVerified    Boolean  @default(false)
  avatarUrl     String?
  bio           String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userSkills    UserSkill[]
  userWants     UserWant[]
  matchesAsA    Match[]   @relation("UserA")
  matchesAsB    Match[]   @relation("UserB")
  sentMessages  Message[] @relation("Sender")
}

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String?  // e.g. "Tech", "Design", "Language"

  userSkills  UserSkill[]
  userWants   UserWant[]
}

model UserSkill {
  id       String @id @default(uuid())
  user     User   @relation(fields: [userId], references: [id])
  userId   String
  skill    Skill  @relation(fields: [skillId], references: [id])
  skillId  String
  level    String? // "Beginner", "Intermediate", "Expert"

  @@unique([userId, skillId])
}

model UserWant {
  id       String @id @default(uuid())
  user     User   @relation(fields: [userId], references: [id])
  userId   String
  skill    Skill  @relation(fields: [skillId], references: [id])
  skillId  String

  @@unique([userId, skillId])
}

model Match {
  id          String    @id @default(uuid())
  userA       User      @relation("UserA", fields: [userAId], references: [id])
  userAId     String
  userB       User      @relation("UserB", fields: [userBId], references: [id])
  userBId     String
  score       Float
  status      String    @default("pending")
  declinedAt  DateTime?
  createdAt   DateTime  @default(now())

  messages    Message[]
  meeting     Meeting?
  insight     MatchInsight?

  @@unique([userAId, userBId])
}

model Message {
  id        String   @id @default(uuid())
  match     Match    @relation(fields: [matchId], references: [id])
  matchId   String
  sender    User     @relation("Sender", fields: [senderId], references: [id])
  senderId  String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Meeting {
  id        String   @id @default(uuid())
  match     Match    @relation(fields: [matchId], references: [id])
  matchId   String  @unique
  roomUrl   String
  createdAt DateTime @default(now())
}

model MatchInsight {
  id          String   @id @default(uuid())
  matchId     String   @unique
  match       Match    @relation(fields: [matchId], references: [id])
  explanation String
  starters    String[] // conversation starter suggestions
  createdAt   DateTime @default(now())
}